# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas, database rankkw_online (never "guestpost": that is the guest post site's)
MONGODB_URI=mongodb+srv://<user>:<password>@database.vjpfzm9.mongodb.net/rankkw_online?retryWrites=true&w=majority&appName=Database

# ─── Etsy Open API (Official) ─────────────────────────────────────────────────
# Apply at: https://www.etsy.com/developers/register
# Docs:     https://developers.etsy.com/documentation/
# This app uses ONLY the official Etsy Open API v3.
# No scraping or third-party data providers are used.
ETSY_API_KEY=your_etsy_api_key_here
# Your Etsy app's Shared Secret. This app sends the header as
# x-api-key: <ETSY_API_KEY>:<ETSY_SHARED_SECRET>
ETSY_SHARED_SECRET=your_etsy_shared_secret_here

# ─── Etsy "Connect your shop" OAuth (Shop Insights) ───────────────────────────
# Enables the My Shop tab (real revenue, orders, sales-by-country, your listings).
# 1) In your Etsy app settings, add this EXACT callback URL under OAuth Redirect URIs:
#      http://localhost:3000/api/etsy/oauth/callback        (dev)
#      https://rankkw.online/api/etsy/oauth/callback      (prod)
# 2) The app requests read scopes: email_r shops_r listings_r transactions_r
# Optional — override the redirect URI (else derived from the request origin):
# ETSY_REDIRECT_URI=https://rankkw.online/api/etsy/oauth/callback
# Optional — dedicated 32+ char key to encrypt stored Etsy tokens at rest.
# If unset, a key is derived from JWT_SECRET automatically.
# TOKEN_ENC_KEY=change_this_to_a_random_64_char_string

# ─── Google Ads API — real Google search volume + country data (optional) ─────
# Powers the Keyword Tool's "Google Searches" column + "Searchers by Country" panel.
# Setup (one time):
#  1) Google Cloud → create an OAuth Client (type: Web app). Put Client ID/Secret below.
#  2) Add BOTH redirect URIs to that OAuth client (exact string match):
#       http://localhost:3000/api/google/oauth/callback   (dev)
#       https://rankkw.online/api/google/oauth/callback      (prod)
#  3) Apply for a Google Ads API Developer Token (in your Google Ads account → API Center).
#  4) Start the dev server, log in as an admin, then visit:
#       http://localhost:3000/api/google/oauth/connect
#     Approve access — the page prints your GOOGLE_ADS_REFRESH_TOKEN to paste below.
#  5) Set GOOGLE_ADS_CUSTOMER_ID (your Google Ads account id, 10 digits, NO dashes).
GOOGLE_ADS_CLIENT_ID=your_google_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_REFRESH_TOKEN=minted_via_/api/google/oauth/connect
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Only if the account above is under a manager (MCC) account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Google sunsets Ads API versions ~yearly; a sunset version 404s on EVERY call.
# Verified 2026-07-16: v18 and v19 are already dead. Default is now v20.
# Check https://developers.google.com/google-ads/api/docs/sunset-dates and bump:
# GOOGLE_ADS_API_VERSION=v20
# Optional override of the OAuth callback (else derived from the request origin):
# GOOGLE_ADS_REDIRECT_URI=https://rankkw.online/api/google/oauth/callback

# ─── AI features — Google Gemini (optional) ───────────────────────────────────
# Powers the AI Listing Helper (titles / tags / description), grounded in the
# real tags of live Etsy listings. Without a key everything runs a rule-based
# fallback built from the same real tags, so the tool works either way.
#
# Get a key at https://aistudio.google.com/apikey . GEMINI_API_KEY is preferred;
# the legacy `Gemini_API_KEY` casing is also accepted.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # alias — tracks the current Flash model so it
#                                    # can't be sunset. Pin a version only if needed.

# ─── Optional: Upstash Redis (distributed cache for production) ───────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# ─── App ───────────────────────────────────────────────────────────────────────
# Local dev keeps localhost. IN PRODUCTION THIS MUST BE https://rankkw.online —
# it is the base URL stamped into password-reset and account-verification
# emails (lib/auth/email.ts). Left at localhost, every reset link a real user
# receives points at their own machine and silently fails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Snapshot cron ────────────────────────────────────────────────────────────
# Guards /api/cron/snapshot, which records each tracked shop's daily sales count.
# Etsy publishes no sales history and it can't be backfilled, so this job is the
# only source of sales-over-time data. Vercel Cron sends this as a Bearer token
# automatically; without it the route refuses to run rather than sitting open.
CRON_SECRET=

# ─── Contact form / email ──────────────────────────────────────────────────────
# Where contact-form messages are delivered, and the From line of emails the site sends.
SUPPORT_EMAIL=support@rankkw.online
EMAIL_FROM="Rankkw Support <support@rankkw.online>"
